# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# auto-generated agent rule files (regenerated by `next dev`/`next build`)
/AGENTS.md
/CLAUDE.md

# cleaned CSVs — regenerable via `npm run clean` (fast, no AI cost)
/refined-data/*.csv
!/refined-data/.gitkeep

# NOTE: /generated/*.json (pipeline output — reviews, analysis, insights,
# opportunities, recommendations) is intentionally NOT ignored — it's
# committed so the dashboard has real data without re-running the paid
# OpenAI pipeline on every clone.
